# Copy to .env and adjust:  cp .env.example .env

# MQTT broker that the Tongdy devices publish to
# (testing: the Mac running mosquitto on port 1884; production: mosquitto on this Pi)
MQTT_HOST=localhost
MQTT_PORT=1884
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=/device/sensor/#
# Must be unique per running copy of app.py (two copies with the same ID kick each other off)
MQTT_CLIENT_ID=tongdy-forwarder-pi01

# Backend (API Gateway -> Lambda -> DynamoDB tongdy_pgx)
API_URL=.../kun-kran/tongdy/insert
# Optional: sent as the x-api-key header; must match API_KEY on the Lambda
API_KEY=

HTTP_TIMEOUT=10
HTTP_RETRIES=3

# Readings that could not be sent are kept here until `python3 app.py resend`
FAILED_DB=failed_records.db
RESEND_BATCH=25
LOG_LEVEL=INFO
